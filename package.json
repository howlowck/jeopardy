{
  "name": "react-jeopardy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.5",
    "dotenv": "^10.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.0.5"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build --outDir build",
    "preview": "vite preview --port 4173",
    "test": "vitest",
    "lint": "eslint src",
    "make": "plop"
  },
  "eslintConfig": {
    "plugins": [
      "react",
      "react-hooks",
      "prettier"
    ],
    "extends": [
      "plugin:react/recommended",
      "plugin:react-hooks/recommended",
      "plugin:prettier/recommended"
    ],
    "rules": {
      "prettier/prettier": "error"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.4.2",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.6",
    "@types/react-modal": "^3.13.2",
    "classnames": "^2.3.2",
    "eslint": "^8.44.0",
    "eslint-plugin-prettier": "^3.3.1",
    "eslint-plugin-react": "^7.33.3",
    "eslint-plugin-react-hooks": "^4.6.0",
    "lodash": "^4.17.21",
    "mkdirp": "^1.0.4",
    "plop": "^2.7.4",
    "prettier": "^2.8.8",
    "react-confetti": "^6.0.0",
    "react-countdown-circle-timer": "^2.3.7",
    "react-modal": "^3.16.1",
    "redux-observable": "^1.2.0",
    "rxjs": "^6.6.3",
    "typescript": "^5.2.2",
    "web-vitals": "^3.3.0",
    "wouter": "^2.11.0",
    "vite": "^5.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vitest": "^1.3.0"
  }
}
