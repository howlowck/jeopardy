{
  "name": "react-jeopardy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
			"@reduxjs/toolkit": "^2.11.2",
			"dotenv": "^17.3.1",
			"react": "^19.2.4",
			"react-dom": "^19.2.4",
			"react-redux": "^9.2.0"
		},
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build --outDir build",
    "preview": "vite preview --port 4173",
    "test": "vitest",
    "lint": "eslint src",
    "make": "plop"
  },
  "eslintConfig": {
    "plugins": [
      "react",
      "react-hooks",
      "prettier"
    ],
    "extends": [
      "plugin:react/recommended",
      "plugin:react-hooks/recommended",
      "plugin:prettier/recommended"
    ],
    "rules": {
      "prettier/prettier": "error"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
			"@types/node": "^22.0.0",
			"@types/react": "^19.2.14",
			"@types/react-dom": "^19.2.3",
			"@types/react-modal": "^3.16.3",
			"classnames": "^2.5.1",
			"eslint": "^8.57.1",
			"eslint-config-prettier": "^10.1.8",
			"eslint-plugin-prettier": "^5.5.5",
			"eslint-plugin-react": "^7.37.5",
			"eslint-plugin-react-hooks": "^5.2.0",
			"lodash": "^4.17.21",
			"mkdirp": "^3.0.1",
			"plop": "^4.0.5",
			"prettier": "^3.8.1",
			"react-confetti": "^6.4.0",
			"react-countdown-circle-timer": "^3.2.1",
			"react-modal": "^3.16.3",
			"redux-observable": "^3.0.0-rc.3",
			"rxjs": "^7.8.2",
			"typescript": "^5.9.3",
			"web-vitals": "^5.2.0",
			"wouter": "^3.9.0",
			"vite": "^6.4.1",
			"@vitejs/plugin-react": "^4.7.0",
			"vitest": "^3.2.4"
		}
}
